rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasPerm(permission) {
      return isAuth() && userDoc().permissions[permission] == true;
    }

    function isAdmin()        { return isAuth() && userRole() == 'admin'; }
    function isDoctor()       { return isAuth() && userRole() == 'doctor'; }
    function isReceptionist() { return isAuth() && userRole() == 'receptionist'; }
    function isPharmacist()   { return isAuth() && userRole() == 'pharmacist'; }
    function isLab()          { return isAuth() && (userRole() == 'lab' || userRole() == 'lab_technician'); }
    function isCashier()      { return isAuth() && userRole() == 'cashier'; }
    function isAccountant()   { return isAuth() && userRole() == 'accountant'; }
    function isNurse()        { return isAuth() && userRole() == 'nurse'; }
    function isClinical()     { return isDoctor() || isNurse(); }
    function canReception()   { return isReceptionist() || hasPerm('hms.reception.view'); }
    function canVitals()      { return isClinical() || hasPerm('hms.vitals.view'); }
    function canToken()       { return hasPerm('hms.token.view'); }
    function canIpd()         { return isClinical() || canReception() || hasPerm('hms.ipd.view'); }
    function canHmsBilling()  { return isReceptionist() || isAccountant() || isCashier() || hasPerm('hms.billing.create') || canReception() || hasPerm('hms.ipd.view'); }
    function canPosBilling()  { return isPharmacist() || isCashier() || hasPerm('pos.billing.create'); }
    function canPosPurchases(){ return isPharmacist() || hasPerm('pos.purchases.create'); }
    function canPosMedicineCreate(){ return isPharmacist() || hasPerm('pos.medicines.create') || userDoc().username == 'haseeb'; }

    // ── Users ──────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuth()
        && request.auth.uid == uid
        && request.auth.token.email == 'admin@gmh-suite.internal'
        && request.resource.data.role == 'admin'
        && request.resource.data.email == 'admin@gmh-suite.internal';
      allow write: if isAdmin();
    }

    // ── Settings ───────────────────────────────────────────────────────────────
    match /settings/{doc} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Plans ──────────────────────────────────────────────────────────────────
    match /plans/{doc} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Patients ───────────────────────────────────────────────────────────────
    match /patients/{doc} {
      allow read: if isAuth();
      allow create, update: if isAdmin() || canReception() || isClinical();
      allow delete: if isAdmin();
    }

    // ── Appointments ───────────────────────────────────────────────────────────
    match /appointments/{doc} {
      allow read: if isAuth();
      allow create: if isAdmin() || canReception() || isClinical();
      allow update: if isAdmin() || canReception() || canVitals() || canToken();
      allow delete: if isAdmin() || canReception();
    }

    // ── Consultations (OPD) ────────────────────────────────────────────────────
    match /consultations/{doc} {
      allow read: if isAuth();
      allow create, update: if isAdmin() || isClinical() || canReception();
      allow delete: if isAdmin();
    }

    // Prescription templates
    match /prescriptionTemplates/{doc} {
      allow read: if isAuth();
      allow create, update: if isAdmin() || isDoctor();
      allow delete: if isAdmin() || isDoctor();
    }

    // ── Staff ──────────────────────────────────────────────────────────────────
    match /staff/{doc} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Medicines ──────────────────────────────────────────────────────────────
    match /medicines/{doc} {
      allow read: if isAuth();
      allow create: if isAdmin() || canPosMedicineCreate();
      allow update: if isAdmin() || canPosBilling() || canPosPurchases() || hasPerm('pos.purchaseReturns.create') || hasPerm('pos.saleReturns.create');
      allow delete: if isAdmin();
    }

    // ── Pharmacy Orders ────────────────────────────────────────────────────────
    match /pharmacyOrders/{doc} {
      allow read: if isAuth();
      allow create: if isAdmin() || isClinical() || canReception();
      allow update: if isAdmin() || canPosBilling();
      allow delete: if isAdmin();
    }

    // ── Lab Tests (definitions) ────────────────────────────────────────────────
    match /labTests/{doc} {
      allow read: if isAuth();
      allow write: if isAdmin() || isLab();
    }

    // ── Lab Orders ─────────────────────────────────────────────────────────────
    match /labOrders/{doc} {
      allow read: if isAuth();
      allow create: if isAdmin() || isClinical() || canReception();
      allow update: if isAdmin() || isLab() || isClinical();
      allow delete: if isAdmin();
    }

    // ── Billing ────────────────────────────────────────────────────────────────
    match /bills/{doc} {
      allow read: if isAuth();
      allow create: if isAdmin() || canHmsBilling();
      allow update: if isAdmin() || canHmsBilling();
      allow delete: if isAdmin();
    }

    // ── Payments ───────────────────────────────────────────────────────────────
    match /payments/{doc} {
      allow read: if isAuth();
      allow create, update: if isAdmin() || canHmsBilling();
      allow delete: if isAdmin();
    }

    // ── Expenses ───────────────────────────────────────────────────────────────
    match /expenses/{doc} {
      allow read: if isAdmin() || isAccountant() || isReceptionist() || hasPerm('pos.expenses.view') || hasPerm('pos.expenses.create');
      allow create: if isAdmin() || isAccountant()
        || (hasPerm('pos.expenses.create')
          && request.resource.data.status == 'pending'
          && request.resource.data.createdBy == request.auth.uid);
      allow update: if isAdmin() || isAccountant();
      allow delete: if isAdmin();
    }

    // ── Suppliers ──────────────────────────────────────────────────────────────
    match /suppliers/{doc} {
      allow read: if isAuth();
      allow create: if isAdmin() || isAccountant() || isPharmacist() || hasPerm('pos.suppliers.create');
      allow update: if isAdmin() || isAccountant() || isPharmacist();
      allow delete: if isAdmin();
    }

    // ── IPD ────────────────────────────────────────────────────────────────────
    match /admissions/{doc} {
      allow read: if isAuth();
      allow create, update: if isAdmin() || canIpd();
      allow delete: if isAdmin();
    }

    match /wards/{doc} {
      allow read: if isAuth();
      allow create, update: if isAdmin() || isClinical() || isReceptionist();
      allow delete: if isAdmin();
    }

    match /rooms/{doc} {
      allow read: if isAuth();
      allow create, update: if isAdmin() || isClinical() || isReceptionist();
      allow delete: if isAdmin();
    }

    match /beds/{doc} {
      allow read: if isAuth();
      allow create: if isAdmin() || isClinical() || isReceptionist();
      allow update: if isAdmin() || canIpd();
      allow delete: if isAdmin();
    }

    match /bedTreatments/{doc} {
      allow read: if isAuth();
      allow create, update: if isAdmin() || canIpd();
      allow delete: if isAdmin();
    }

    // ── Audit Logs (append-only) ───────────────────────────────────────────────
    match /auditLogs/{doc} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Notifications ──────────────────────────────────────────────────────────
    match /notifications/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAdmin() || resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── Schedules ──────────────────────────────────────────────────────────────
    match /schedules/{doc} {
      allow read: if isAuth();
      allow write: if isAdmin() || isReceptionist();
    }

    // ── Counters (MRN, bill number sequences) ──────────────────────────────────
    match /counters/{doc} {
      allow read, write: if isAuth();
    }

    // ── POS collections ────────────────────────────────────────────────────────
    match /posSales/{doc} {
      allow read: if isAuth();
      allow create, update: if isAdmin() || isPharmacist();
      allow delete: if isAdmin();
    }

    match /sales/{doc} {
      allow read: if isAuth();
      allow create: if isAdmin() || canPosBilling();
      allow update: if isAdmin() || isPharmacist() || isCashier() || hasPerm('pos.sales.edit');
      allow delete: if isAdmin();
    }

    match /posPurchases/{doc} {
      allow read: if isAuth();
      allow create, update: if isAdmin() || isPharmacist();
      allow delete: if isAdmin();
    }

    match /purchases/{doc} {
      allow read: if isAuth();
      allow create: if isAdmin() || canPosPurchases();
      allow update: if isAdmin() || isPharmacist();
      allow delete: if isAdmin();
    }

    match /purchaseReturns/{doc} {
      allow read: if isAuth();
      allow create, update: if isAdmin() || isPharmacist() || hasPerm('pos.purchaseReturns.create');
      allow delete: if isAdmin();
    }

    match /saleReturns/{doc} {
      allow read: if isAuth();
      allow create, update: if isAdmin() || isCashier() || hasPerm('pos.saleReturns.create');
      allow delete: if isAdmin();
    }

    match /customers/{doc} {
      allow read: if isAuth();
      allow create: if isAdmin() || isCashier() || hasPerm('pos.customers.create');
      allow update: if isAdmin() || isCashier() || hasPerm('pos.customers.edit') || hasPerm('pos.billing.create');
      allow delete: if isAdmin();
    }

    match /customerPayments/{doc} {
      allow read: if isAdmin() || isCashier() || hasPerm('pos.customers.view');
      allow create, update: if isAdmin() || isCashier() || hasPerm('pos.customers.payments');
      allow delete: if isAdmin();
    }

    match /posExpenses/{doc} {
      allow read: if isAdmin() || isAccountant() || isPharmacist() || hasPerm('pos.expenses.view') || hasPerm('pos.expenses.create');
      allow create: if isAdmin() || isPharmacist()
        || (hasPerm('pos.expenses.create')
          && request.resource.data.status == 'pending'
          && request.resource.data.createdBy == request.auth.uid);
      allow update: if isAdmin() || isPharmacist();
      allow delete: if isAdmin();
    }

    // ── Catch-all: only admin can touch anything not listed above ──────────────
    match /{collection}/{document=**} {
      allow read, write: if isAdmin();
    }

  }
}
