APP_ENV=production
APP_DEBUG=false
APP_URL=https://gmh.example.com
APP_TIMEZONE=Asia/Karachi
API_ALLOWED_ORIGINS=https://gmh.example.com,capacitor://localhost,http://localhost,https://localhost,null
API_MAX_BODY_BYTES=8388608
API_PAGE_SIZE=500
API_MAX_PAGE_SIZE=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=gmh_suite
DB_USER=gmh_suite_user
DB_PASSWORD=replace-with-a-long-random-password
DB_CHARSET=utf8mb4

FIREBASE_PROJECT_ID=gmh-hospital-management-suite
FIREBASE_SERVICE_ACCOUNT=/home/hostinger-user/private/gmh-firebase-service-account.json
FIRESTORE_MIRROR_ENABLED=true
FIRESTORE_MIRROR_BATCH_SIZE=200
FIRESTORE_MIRROR_MAX_ATTEMPTS_PER_RUN=1000

IMPORT_MAX_DOCUMENTS=100000
BACKUP_DIRECTORY=/home/hostinger-user/private/gmh-backups
BACKEND_FEATURE_ENABLED=true
